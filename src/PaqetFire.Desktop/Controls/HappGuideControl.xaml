<UserControl
    x:Class="PaqetFire.Desktop.Controls.HappGuideControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="920" Padding="36,28,36,48" HorizontalAlignment="Stretch" Spacing="20">

      <!-- Navigation Header -->
      <StackPanel Spacing="12">
        <Button x:Name="BackButton" Click="BackButton_Click" HorizontalAlignment="Left"
                Padding="12,6" CornerRadius="8" Background="Transparent" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72B;" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="Back to Routing" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- HAPP / Hiddify Badge Icon -->
          <Border Width="56" Height="56" CornerRadius="16" Margin="0,0,18,0"
                  Background="#0D9488" VerticalAlignment="Center">
            <!-- Shield vector icon -->
            <Path Data="M 28,12 L 42,18 L 42,30 C 42,38.5 28,45 28,45 C 28,45 14,38.5 14,30 L 14,18 Z"
                  Fill="White" Stretch="Uniform" Width="26" Height="26"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="HAPP / HIDDIFY SETUP GUIDE" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource PaqetFireAccentBrush}" CharacterSpacing="110" />
              <Border Background="#200D9488" CornerRadius="6" Padding="6,2">
                <TextBlock Text="iOS / Android / PC" FontSize="11" FontWeight="SemiBold" Foreground="#14B8A6" />
              </Border>
            </StackPanel>
            <TextBlock Text="Configure HAPP or Hiddify" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Step-by-step instructions to route iOS, Android, or PC clients through the PaqetFire mobile hotspot."
                       FontSize="14" Opacity="0.72" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <InfoBar x:Name="FeedbackInfoBar" IsOpen="False" IsClosable="True" Margin="0,4" />

      <!-- Step 1: Connect to Hotspot -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
              <TextBlock Text="1" FontWeight="Bold" Foreground="White" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Connect your device to the Laptop Hotspot" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Ensure your iPhone, iPad, Android phone, or client PC has Wi-Fi enabled and is joined to this laptop's mobile hotspot network."
                     Opacity="0.75" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Step 2: Install App -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
              <TextBlock Text="2" FontWeight="Bold" Foreground="White" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Install HAPP (iOS) or Hiddify (All Platforms)" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="• iOS (iPhone / iPad): Install HAPP Proxy from the Apple App Store (or Hiddify iOS).&#x0a;• Android: Install Hiddify from Google Play Store or GitHub.&#x0a;• Windows / macOS / Linux: Install Hiddify desktop app."
                     Opacity="0.75" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Step 3: Fast Method (Import from Clipboard) -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{StaticResource PaqetFireAccentBrush}" BorderThickness="1.5">
        <StackPanel Spacing="12">
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
                <TextBlock Text="3" FontWeight="Bold" Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Method A: Import from Clipboard (Fastest)" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#2422C55E" CornerRadius="6" Padding="8,3">
              <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" />
            </Border>
          </Grid>

          <TextBlock Text="1. Click 'Copy SOCKS URI' below and transfer the link to your device (via AirDrop, email, or chat app)."
                     Opacity="0.8" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="2. On your device, copy the link to the clipboard, then launch HAPP or Hiddify."
                     Opacity="0.8" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="3. In HAPP / Hiddify: Tap 'Proxy' → '+' (or 'Add profile') → choose 'Add from clipboard'."
                     Opacity="0.8" FontSize="13" TextWrapping="Wrap" />

          <Grid ColumnSpacing="10" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SocksUriBox" IsReadOnly="True" FontSize="12"
                     PlaceholderText="socks5://paqetfire:password@192.168.137.1:10808" />
            <Button x:Name="CopyUriButton" Grid.Column="1" Content="Copy SOCKS URI" Click="CopySocksUriButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Step 4: Manual Proxy Configuration -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
              <TextBlock Text="4" FontWeight="Bold" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Method B: Manual SOCKS5 Proxy Entry" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="If adding manually, select Protocol: SOCKS5 (or Socks), and enter these values:"
                     Opacity="0.75" FontSize="13" TextWrapping="Wrap" />

          <Grid ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Server / IP -->
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock Text="Server (Address / IP)" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerAddressBox" IsReadOnly="True" PlaceholderText="192.168.137.1" />
                <Button Grid.Column="1" Content="Copy" Click="CopyServerAddressButton_Click" />
              </Grid>
            </StackPanel>

            <!-- Port -->
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <TextBlock Text="Port" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerPortBox" IsReadOnly="True" PlaceholderText="10808" />
                <Button Grid.Column="1" Content="Copy" Click="CopyServerPortButton_Click" />
              </Grid>
            </StackPanel>

            <!-- Username -->
            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
              <TextBlock Text="Username" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UsernameBox" IsReadOnly="True" PlaceholderText="paqetfire" />
                <Button Grid.Column="1" Content="Copy" Click="CopyUsernameButton_Click" />
              </Grid>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
              <TextBlock Text="Password" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PasswordBox" IsReadOnly="True" PlaceholderText="Password" />
                <Button x:Name="CopyPasswordButton" Grid.Column="1" Content="Copy" Click="CopyPasswordButton_Click" />
              </Grid>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Step 5: Enable Remote DNS & Routing Mode -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="#EAB308">
              <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Crucial Settings: Remote DNS &amp; Routing Mode" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <Border Padding="14" CornerRadius="12" Background="#14FFB020">
            <StackPanel Spacing="6">
              <TextBlock Text="Enable 'Remote DNS' in HAPP / Hiddify proxy settings." FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="Make sure Remote DNS is enabled so domain lookups are resolved through PaqetFire's upstream tunnel. Set Routing / Mode to 'Proxy' (or System Proxy) so app traffic routes through this SOCKS5 outbound."
                         Opacity="0.82" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Step 6: Connect & Test -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
              <TextBlock Text="5" FontWeight="Bold" Foreground="White" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Connect and verify" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="1. Tap the Connect / Start button in HAPP or Hiddify. On iOS, allow the system VPN configuration prompt when asked." Opacity="0.75" FontSize="13" />
          <TextBlock Text="2. Once connected, open Safari or Chrome on your device and browse the web. Your client is now fully protected and routed through PaqetFire." Opacity="0.75" FontSize="13" />
        </StackPanel>
      </Border>

      <Button Content="Done — Return to Routing" Click="BackButton_Click" HorizontalAlignment="Left"
              Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
