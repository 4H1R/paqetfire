<UserControl
    x:Class="PaqetFire.Desktop.Controls.HotspotClientGuideControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <UserControl.Resources>
    <Style x:Key="GuideStepCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="22" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="GuideStepNumberStyle" TargetType="Border">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="GuideStepNumberTextStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GuideStepTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GuideBodyTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GuideOptionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GuideFieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </UserControl.Resources>

  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Key="Escape" Invoked="BackAccelerator_Invoked" />
    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
  </UserControl.KeyboardAccelerators>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="920" Padding="36,28,36,48" HorizontalAlignment="Stretch" Spacing="20">

      <!-- Navigation header -->
      <StackPanel Spacing="12">
        <Button x:Name="BackButton" Click="BackButton_Click" HorizontalAlignment="Left"
                Padding="12,6" CornerRadius="8" Background="Transparent" BorderThickness="0"
                ToolTipService.ToolTip="Back to Routing (Esc or Alt+Left)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72B;" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="Back to Routing" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Width="56" Height="56" CornerRadius="16" Margin="0,0,18,0" VerticalAlignment="Center"
                  Background="{ThemeResource AccentFillColorDefaultBrush}">
            <Grid>
              <!-- v2rayNG: paper airplane -->
              <Path x:Name="V2rayNgIcon" Data="M 14,38 L 42,28 L 14,18 L 14,25 L 32,28 L 14,31 Z"
                    Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Stretch="Uniform"
                    Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <!-- HAPP / Hiddify: shield -->
              <Path x:Name="HappIcon" Data="M 28,12 L 42,18 L 42,30 C 42,38.5 28,45 28,45 C 28,45 14,38.5 14,30 L 14,18 Z"
                    Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Stretch="Uniform" Visibility="Collapsed"
                    Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="EyebrowText" FontSize="12" FontWeight="SemiBold"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" CharacterSpacing="110" />
              <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2">
                <TextBlock x:Name="PlatformText" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="SubtitleText" FontSize="14" Opacity="0.72" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- Step 1: join the hotspot -->
      <Border Style="{StaticResource GuideStepCardStyle}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Style="{StaticResource GuideStepNumberStyle}">
              <TextBlock Text="1" Style="{StaticResource GuideStepNumberTextStyle}" />
            </Border>
            <TextBlock Text="Join this laptop's mobile hotspot" Style="{StaticResource GuideStepTitleStyle}"
                       AutomationProperties.HeadingLevel="Level2" />
          </StackPanel>
          <TextBlock x:Name="JoinHotspotText" Style="{StaticResource GuideBodyTextStyle}" />
        </StackPanel>
      </Border>

      <!-- Step 2: install the app -->
      <Border Style="{StaticResource GuideStepCardStyle}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Style="{StaticResource GuideStepNumberStyle}">
              <TextBlock Text="2" Style="{StaticResource GuideStepNumberTextStyle}" />
            </Border>
            <TextBlock x:Name="InstallTitleText" Style="{StaticResource GuideStepTitleStyle}"
                       AutomationProperties.HeadingLevel="Level2" />
          </StackPanel>
          <TextBlock x:Name="InstallText" Style="{StaticResource GuideBodyTextStyle}" />
        </StackPanel>
      </Border>

      <!-- Step 3: add the proxy, by QR code or by hand -->
      <Border Style="{StaticResource GuideStepCardStyle}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Style="{StaticResource GuideStepNumberStyle}">
              <TextBlock Text="3" Style="{StaticResource GuideStepNumberTextStyle}" />
            </Border>
            <TextBlock Text="Add the PaqetFire proxy" Style="{StaticResource GuideStepTitleStyle}"
                       AutomationProperties.HeadingLevel="Level2" />
          </StackPanel>
          <TextBlock Text="Use either option A or option B." Style="{StaticResource GuideBodyTextStyle}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Option A: scan the QR code" Style="{StaticResource GuideOptionTitleStyle}" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level3" />
            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6" Padding="8,3">
              <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold"
                         Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </Border>
          </StackPanel>
          <TextBlock x:Name="ScanQrText" Style="{StaticResource GuideBodyTextStyle}" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Image x:Name="QrImage" Width="184" Height="184" Stretch="Uniform" Visibility="Collapsed"
                   AutomationProperties.Name="QR code of the SOCKS URI" />
            <StackPanel x:Name="QrPlaceholder" Spacing="8" MaxWidth="440" VerticalAlignment="Center">
              <TextBlock x:Name="QrPlaceholderText" Text="Detect the hotspot on the Routing page to show a QR code."
                         TextWrapping="Wrap" Opacity="0.75" />
              <Button x:Name="RotateCredentialsButton" Content="Rotate credentials to show QR" Visibility="Collapsed"
                      Click="RotateCredentialsButton_Click" />
            </StackPanel>
          </StackPanel>
          <TextBlock Style="{StaticResource GuideBodyTextStyle}"
                     Text="The QR code and the SOCKS URI contain the sharing password. Copy SOCKS URI only fills this PC's clipboard, for pasting on this PC; do not send the URI through messaging apps, email, or other third-party services." />
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SocksUriBox" IsReadOnly="True" FontSize="12" AutomationProperties.Name="SOCKS URI"
                     PlaceholderText="socks5://paqetfire:password@192.168.137.1:10808" />
            <Button x:Name="CopyUriButton" Grid.Column="1" Content="Copy SOCKS URI" Click="CopySocksUriButton_Click" />
          </Grid>

          <TextBlock Text="Option B: enter the details by hand" Style="{StaticResource GuideOptionTitleStyle}" Margin="0,8,0,0"
                     AutomationProperties.HeadingLevel="Level3" />
          <TextBlock x:Name="ManualText" Style="{StaticResource GuideBodyTextStyle}" />

          <Grid ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock Text="Server (address)" Style="{StaticResource GuideFieldLabelStyle}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerAddressBox" IsReadOnly="True" PlaceholderText="192.168.137.1"
                         AutomationProperties.Name="Server address" />
                <Button Grid.Column="1" Content="Copy" Click="CopyServerAddressButton_Click"
                        AutomationProperties.Name="Copy server address" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <TextBlock Text="Port" Style="{StaticResource GuideFieldLabelStyle}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerPortBox" IsReadOnly="True" PlaceholderText="10808"
                         AutomationProperties.Name="Port" />
                <Button Grid.Column="1" Content="Copy" Click="CopyServerPortButton_Click"
                        AutomationProperties.Name="Copy port" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
              <TextBlock Text="Username" Style="{StaticResource GuideFieldLabelStyle}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UsernameBox" IsReadOnly="True" PlaceholderText="paqetfire"
                         AutomationProperties.Name="Username" />
                <Button Grid.Column="1" Content="Copy" Click="CopyUsernameButton_Click"
                        AutomationProperties.Name="Copy username" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
              <TextBlock Text="Password" Style="{StaticResource GuideFieldLabelStyle}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PasswordValueBox" IsReadOnly="True" AutomationProperties.Name="Password, hidden"
                         PlaceholderText="Saved password is protected; rotate credentials to show a new one" />
                <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="1" Content="Show"
                              Checked="ShowPasswordToggle_Changed" Unchecked="ShowPasswordToggle_Changed"
                              AutomationProperties.Name="Show password" />
                <Button x:Name="CopyPasswordButton" Grid.Column="2" Content="Copy" Click="CopyPasswordButton_Click"
                        AutomationProperties.Name="Copy password" />
              </Grid>
            </StackPanel>
          </Grid>
          <InfoBar x:Name="FeedbackInfoBar" IsOpen="False" IsClosable="True" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>

      <!-- Step 4: remote DNS and the app's mode -->
      <Border Style="{StaticResource GuideStepCardStyle}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Style="{StaticResource GuideStepNumberStyle}">
              <TextBlock Text="4" Style="{StaticResource GuideStepNumberTextStyle}" />
            </Border>
            <TextBlock x:Name="SettingsTitleText" Style="{StaticResource GuideStepTitleStyle}"
                       AutomationProperties.HeadingLevel="Level2" />
          </StackPanel>
          <Border Padding="14" CornerRadius="12" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
            <StackPanel Spacing="6">
              <TextBlock x:Name="RemoteDnsText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
              <TextBlock x:Name="RemoteDnsWhyText" Opacity="0.82" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Step 5: connect and check -->
      <Border Style="{StaticResource GuideStepCardStyle}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Style="{StaticResource GuideStepNumberStyle}">
              <TextBlock Text="5" Style="{StaticResource GuideStepNumberTextStyle}" />
            </Border>
            <TextBlock Text="Connect and check" Style="{StaticResource GuideStepTitleStyle}"
                       AutomationProperties.HeadingLevel="Level2" />
          </StackPanel>
          <TextBlock x:Name="ConnectText" Style="{StaticResource GuideBodyTextStyle}" />
          <TextBlock Style="{StaticResource GuideBodyTextStyle}"
                     Text="Open a browser on the device and load a website. Its traffic now goes through PaqetFire's route. The Wi-Fi hop from the device to this PC is plain SOCKS5 and is not encrypted, so keep the hotspot's Wi-Fi password strong." />
        </StackPanel>
      </Border>

      <Button Content="Done — return to Routing" Click="BackButton_Click" HorizontalAlignment="Left"
              Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
