<UserControl
    x:Class="PaqetFire.Desktop.Controls.V2rayNgGuideControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="920" Padding="36,28,36,48" HorizontalAlignment="Stretch" Spacing="20">

      <!-- Navigation Header -->
      <StackPanel Spacing="12">
        <Button x:Name="BackButton" Click="BackButton_Click" HorizontalAlignment="Left"
                Padding="12,6" CornerRadius="8" Background="Transparent" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72B;" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="Back to Routing" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- v2rayNG Badge Icon -->
          <Border Width="56" Height="56" CornerRadius="16" Margin="0,0,18,0"
                  Background="#7C4DFF" VerticalAlignment="Center">
            <!-- Paper airplane vector icon -->
            <Path Data="M 14,38 L 42,28 L 14,18 L 14,25 L 32,28 L 14,31 Z"
                  Fill="White" Stretch="Uniform" Width="28" Height="28"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="v2rayNG SETUP GUIDE" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource PaqetFireAccentBrush}" CharacterSpacing="110" />
              <Border Background="#207C4DFF" CornerRadius="6" Padding="6,2">
                <TextBlock Text="Android" FontSize="11" FontWeight="SemiBold" Foreground="#9E75FF" />
              </Border>
            </StackPanel>
            <TextBlock Text="Configure v2rayNG on Android" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Follow these steps to route your Android device through the PaqetFire mobile hotspot."
                       FontSize="14" Opacity="0.72" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <InfoBar x:Name="FeedbackInfoBar" IsOpen="False" IsClosable="True" Margin="0,4" />

      <!-- Step 1: Connect to Hotspot -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
              <TextBlock Text="1" FontWeight="Bold" Foreground="White" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Connect phone to the Mobile Hotspot" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Open Wi-Fi settings on your Android phone and connect to this laptop's mobile hotspot network. Ensure the connection is established before continuing."
                     Opacity="0.75" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Step 2: Install App -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
              <TextBlock Text="2" FontWeight="Bold" Foreground="White" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Install v2rayNG on your phone" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Download and install v2rayNG from Google Play Store or GitHub releases (v2rayNG repository). Bare Android Wi-Fi proxy settings do not support UDP/DNS, so a SOCKS app like v2rayNG is required."
                     Opacity="0.75" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Step 3: Fast Method (Import from Clipboard) -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{StaticResource PaqetFireAccentBrush}" BorderThickness="1.5">
        <StackPanel Spacing="12">
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
                <TextBlock Text="3" FontWeight="Bold" Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Method A: 1-Click Import from Clipboard (Fastest)" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#2422C55E" CornerRadius="6" Padding="8,3">
              <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" />
            </Border>
          </Grid>

          <TextBlock Text="1. Click 'Copy SOCKS URI' below. Send or paste the link to your phone (via messaging app, email, or clipboard sharing)."
                     Opacity="0.8" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="2. On your phone, copy the link, then open v2rayNG."
                     Opacity="0.8" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="3. Tap the '+' button in the top-right corner of v2rayNG and choose 'Import config from Clipboard'."
                     Opacity="0.8" FontSize="13" TextWrapping="Wrap" />

          <Grid ColumnSpacing="10" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SocksUriBox" IsReadOnly="True" FontSize="12"
                     PlaceholderText="socks5://paqetfire:password@192.168.137.1:10808" />
            <Button x:Name="CopyUriButton" Grid.Column="1" Content="Copy SOCKS URI" Click="CopySocksUriButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Step 4: Manual Outbound Configuration -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
              <TextBlock Text="4" FontWeight="Bold" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Method B: Manual SOCKS Configuration" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="If you prefer entering the proxy settings manually in v2rayNG: tap '+' in the top right → 'Socks'. Fill in the fields below using the quick copy buttons:"
                     Opacity="0.75" FontSize="13" TextWrapping="Wrap" />

          <Grid ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Server / IP -->
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
              <TextBlock Text="Server (Address)" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerAddressBox" IsReadOnly="True" PlaceholderText="192.168.137.1" />
                <Button Grid.Column="1" Content="Copy" Click="CopyServerAddressButton_Click" />
              </Grid>
            </StackPanel>

            <!-- Port -->
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
              <TextBlock Text="Port" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerPortBox" IsReadOnly="True" PlaceholderText="10808" />
                <Button Grid.Column="1" Content="Copy" Click="CopyServerPortButton_Click" />
              </Grid>
            </StackPanel>

            <!-- Username -->
            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
              <TextBlock Text="Username" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UsernameBox" IsReadOnly="True" PlaceholderText="paqetfire" />
                <Button Grid.Column="1" Content="Copy" Click="CopyUsernameButton_Click" />
              </Grid>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
              <TextBlock Text="Password" FontSize="12" Opacity="0.7" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PasswordBox" IsReadOnly="True" PlaceholderText="Password" />
                <Button x:Name="CopyPasswordButton" Grid.Column="1" Content="Copy" Click="CopyPasswordButton_Click" />
              </Grid>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Step 5: Enable Remote DNS -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="#EAB308">
              <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Crucial Setting: Enable Remote DNS" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <Border Padding="14" CornerRadius="12" Background="#14FFB020">
            <StackPanel Spacing="6">
              <TextBlock Text="In v2rayNG profile settings, toggle on 'Remote DNS'." FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="Why? Without Remote DNS, Android resolves domain names locally before sending requests, causing DNS poisoning and regional routing failures. Enabling Remote DNS forwards all domain lookups through the PaqetFire route."
                         Opacity="0.82" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Step 6: Connect & Test -->
      <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PaqetFireAccentBrush}">
              <TextBlock Text="5" FontWeight="Bold" Foreground="White" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Connect and verify" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="1. Select the imported or created profile in v2rayNG." Opacity="0.75" FontSize="13" />
          <TextBlock Text="2. Tap the circular 'V' button at the bottom of the screen to connect. Accept Android's VPN connection prompt if asked." Opacity="0.75" FontSize="13" />
          <TextBlock Text="3. Open your phone's browser and test your internet connection. Your traffic is now secured and routed through PaqetFire." Opacity="0.75" FontSize="13" />
        </StackPanel>
      </Border>

      <Button Content="Done — Return to Routing" Click="BackButton_Click" HorizontalAlignment="Left"
              Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
