<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PaqetFire.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PaqetFire.ico</ApplicationIcon>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The UI is English-only; skip localized framework resource assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Program.cs provides Main so a second launch can be redirected to the running instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference only the Windows App SDK component that the desktop app uses.
      The umbrella package also deploys AI/ML, Search, Widgets, and DWrite
      components in self-contained builds, adding tens of megabytes of unused
      binaries to the installer.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 asks for 2.1.8, which was never published; 2.1.9 is the Windows App SDK 2.5.1 pairing. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <!-- MIT-licensed QR encoder for the hotspot share code. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaqetFire.Core\PaqetFire.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\PaqetFire.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PaqetFire-64.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The unpackaged WinUI publish pipeline can omit the app's generated PRI/XBF
    resources even though they are present in TargetDir. Without them WinUI
    terminates during Application.LoadComponent.
  -->
  <Target Name="PublishWinUiCompiledResources" AfterTargets="Publish">
    <ItemGroup>
      <_PaqetFireWinUiResource Include="$(TargetDir)**\*.xbf" />
      <_PaqetFireWinUiResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>

    <Copy
        SourceFiles="@(_PaqetFireWinUiResource)"
        DestinationFiles="@(_PaqetFireWinUiResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />

    <Error
        Condition="!Exists('$(PublishDir)App.xbf') or !Exists('$(PublishDir)MainWindow.xbf') or !Exists('$(PublishDir)Controls\HotspotClientGuideControl.xbf') or !Exists('$(PublishDir)$(AssemblyName).pri')"
        Text="The WinUI PRI/XBF resources were not copied into the publish directory." />
  </Target>
</Project>
