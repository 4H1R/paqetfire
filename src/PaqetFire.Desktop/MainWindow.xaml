<Window
    x:Class="PaqetFire.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PaqetFire.Desktop.Controls"
    xmlns:vm="using:PaqetFire.Desktop.ViewModels"
    xmlns:presentation="using:PaqetFire.Desktop.Presentation">

  <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
      <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Padding="16,0,16,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Width="30" Height="30" Source="Assets/PaqetFire-64.png" Stretch="Uniform"
               AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="PaqetFire" FontSize="14" FontWeight="SemiBold" />
        <Border x:Name="VersionBadge" Height="22" MinWidth="44" Padding="8,0"
                CornerRadius="7" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <TextBlock x:Name="VersionBadgeText" Text="v0.0.0" FontSize="10" FontWeight="SemiBold" Opacity="0.78"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Grid>

    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        OpenPaneLength="224"
        SelectedItem="{x:Bind OverviewNavigationItem}"
        SelectionChanged="NavigationView_SelectionChanged"
        ItemInvoked="NavigationView_ItemInvoked">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="OverviewNavigationItem" Content="Overview" Tag="overview">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Paqet connection" Tag="connection">
          <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Routing" Tag="routing">
          <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid>
        <ScrollViewer x:Name="OverviewPage">
          <Grid MaxWidth="1120" Padding="36,28,36,48" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
              <TextBlock Text="CONTROL CENTER" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource PaqetFireAccentBrush}" CharacterSpacing="110" />
              <TextBlock Text="Your private route, at a glance" FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="Paqet carries the connection. Xray chooses destinations. ProxiFyre chooses applications."
                         FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="OverviewInfoBar" Grid.Row="1" Margin="0,18,0,0" IsOpen="False" IsClosable="True"
                     HorizontalAlignment="Stretch" />

            <Border x:Name="SetupChecklistCard" Grid.Row="2" Margin="0,18,0,0" Padding="22" CornerRadius="20"
                    HorizontalAlignment="Stretch" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource PaqetFireAccentBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Get started" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ChecklistEntries}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:SetupChecklistItem">
                      <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="24" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Glyph}" FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" FontSize="12" Opacity="0.75"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ChecklistNoteText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="InstallAllMissingButton" Content="Install all missing" Style="{StaticResource AccentButtonStyle}"
                          Click="InstallAllMissingButton_Click" />
                  <Button x:Name="ChecklistServerButton" Content="Enter server details" Visibility="Collapsed"
                          Click="ChecklistServerButton_Click" />
                  <HyperlinkButton Content="Required software details" Tag="diagnostics" Click="NavigateLink_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="0,18,0,0" Padding="28" CornerRadius="24" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="13">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Ellipse x:Name="ConnectionStateIndicator" Width="9" Height="9"
                             Fill="{StaticResource PaqetFireNeutralBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock x:Name="StatusTextBlock" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{x:Bind ViewModel.StatusDescription, Mode=OneWay}" FontSize="14" Opacity="0.7" TextWrapping="Wrap" />
                  <Border Padding="12,9" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Effective routing" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                      <TextBlock Text="{x:Bind ViewModel.EffectiveRoutingText, Mode=OneWay}"
                                 FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MaxWidth="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Profile" VerticalAlignment="Center" Opacity="0.7" />
                    <ComboBox x:Name="OverviewProfilePicker" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ProfileEntries}" DisplayMemberPath="DisplayName"
                              IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                              SelectionChanged="OverviewProfilePicker_SelectionChanged"
                              AutomationProperties.Name="Active profile" />
                  </Grid>
                  <Border Padding="14,10" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{x:Bind ViewModel.ProgressSteps}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="presentation:ConnectionProgressStep">
                            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{x:Bind Opacity}"
                                        AutomationProperties.Name="{x:Bind AccessibleName}">
                              <TextBlock Text="{x:Bind Glyph}" Width="16" AutomationProperties.AccessibilityView="Raw" />
                              <TextBlock Text="{x:Bind Label}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Warning"
                           IsClosable="False" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Assertive">
                    <InfoBar.ActionButton>
                      <Button x:Name="OverviewErrorActionButton" Content="{x:Bind ViewModel.FailureActionText, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasFailureAction, Mode=OneWay}"
                              Click="OverviewErrorActionButton_Click" />
                    </InfoBar.ActionButton>
                  </InfoBar>
                  <InfoBar IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Severity="Informational"
                           IsClosable="True" Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                           CloseButtonClick="NoticeInfoBar_CloseButtonClick"
                           AutomationProperties.LiveSetting="Polite" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanPrimaryAction, Mode=OneWay}"
                            Click="PrimaryConnectionActionButton_Click"
                            Style="{StaticResource AccentButtonStyle}" MinWidth="142"
                            AccessKey="C" KeyboardAcceleratorPlacementMode="Hidden" />
                    <Button Content="Cancel" Visibility="{x:Bind ViewModel.CanCancelConnect, Mode=OneWay}"
                            Click="CancelConnectButton_Click"
                            ToolTipService.ToolTip="Stop connecting and shut down the engines that already started" />
                    <Button Content="Open diagnostics" Tag="diagnostics" Click="NavigateLink_Click"
                            Visibility="{x:Bind ViewModel.ShowDiagnosticsShortcut, Mode=OneWay}" />
                    <Button Content="Refresh" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                            Click="RefreshButton_Click" AccessKey="R" ToolTipService.ToolTip="Refresh status (F5)" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  AutomationProperties.Name="Working" />
                  </StackPanel>
                </StackPanel>
                <Border x:Name="ConnectionStateIconSurface" Grid.Column="1" Width="112" Height="112" CornerRadius="56"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                  <FontIcon x:Name="ConnectionStateIcon" Glyph="&#xE774;" FontSize="42"
                            Foreground="{StaticResource PaqetFireNeutralBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                </Border>
              </Grid>
            </Border>

            <Border x:Name="LiveSessionCard" Grid.Row="4" Margin="0,18,0,0" Padding="24" CornerRadius="24"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource PaqetFireSuccessBrush}" BorderThickness="1">
              <Grid ColumnSpacing="24" RowSpacing="18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="CONNECTED FOR" FontSize="11" FontWeight="SemiBold" Opacity="0.65" CharacterSpacing="110" />
                    <TextBlock Text="{x:Bind ViewModel.Live.ElapsedText, Mode=OneWay}" FontSize="38" FontWeight="SemiBold"
                               FontFamily="Cascadia Mono, Consolas"
                               AutomationProperties.Name="Connected duration" />
                  </StackPanel>

                  <Border Padding="14,9" CornerRadius="16" HorizontalAlignment="Left"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="Exit IP" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                      <Border Padding="6,1" CornerRadius="5" VerticalAlignment="Center"
                              Visibility="{x:Bind ViewModel.Live.HasCountryCode, Mode=OneWay}"
                              Background="{StaticResource PaqetFireSuccessBrush}">
                        <TextBlock Text="{x:Bind ViewModel.Live.CountryCode, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                                   Foreground="Black" AutomationProperties.Name="Exit country" />
                      </Border>
                      <TextBlock Text="{x:Bind ViewModel.Live.PublicAddressText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                 FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                    </StackPanel>
                  </Border>

                  <Border Padding="14,10" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Protocol" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Live.ProtocolText, Mode=OneWay}" FontWeight="SemiBold"
                                 FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>

                  <Border Padding="14,10" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Endpoint" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Live.EndpointText, Mode=OneWay}" FontWeight="SemiBold"
                                 FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    </Grid>
                  </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                  <Border Padding="16,14" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                          <FontIcon Glyph="&#xE74B;" FontSize="14" Foreground="{StaticResource PaqetFireSuccessBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind ViewModel.Live.DownloadRateText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                     FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Download rate" />
                          <TextBlock Text="{x:Bind ViewModel.Live.DownloadTotalText, Mode=OneWay}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                      </StackPanel>
                      <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                          <FontIcon Glyph="&#xE74A;" FontSize="14" Foreground="{StaticResource PaqetFireSuccessBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind ViewModel.Live.UploadRateText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                     FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Upload rate" />
                          <TextBlock Text="{x:Bind ViewModel.Live.UploadTotalText, Mode=OneWay}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Padding="16,14" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Latency" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Live.LatencyText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Latency" />
                      </StackPanel>
                      <Grid>
                        <TextBlock Text="Ping strength" FontSize="11" Opacity="0.65" />
                        <TextBlock Text="{x:Bind ViewModel.Live.QualityText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{x:Bind QualityBrush(ViewModel.Live.Quality), Mode=OneWay}" />
                      </Grid>
                      <ItemsControl ItemsSource="{x:Bind ViewModel.Live.PingBars}" Height="24"
                                    AutomationProperties.AccessibilityView="Raw">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PingBar">
                            <Rectangle Width="7" Height="{x:Bind Height}" RadiusX="3.5" RadiusY="3.5"
                                       VerticalAlignment="Center" Opacity="{x:Bind Opacity}"
                                       Fill="{StaticResource PaqetFireSuccessBrush}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="0,18,0,0" ColumnSpacing="18" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Padding="22" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE968;" Foreground="{StaticResource PaqetFireAccentBrush}" />
                    <TextBlock Text="Paqet engine" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{x:Bind ViewModel.PaqetStatusText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="{x:Bind ViewModel.PaqetDetailText, Mode=OneWay}" Opacity="0.65" TextWrapping="Wrap" />
                  <HyperlinkButton Content="Configure connection" Tag="connection" Click="NavigateLink_Click" Padding="0,4" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="22" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8A7;" Foreground="{StaticResource PaqetFireAccentBrush}" />
                    <TextBlock Text="Application routing" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{x:Bind ViewModel.RoutingStatusText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{x:Bind ViewModel.RoutingDetailText, Mode=OneWay}" Opacity="0.65" TextWrapping="Wrap" />
                  <HyperlinkButton Content="Edit routing policy" Tag="routing" Click="NavigateLink_Click" Padding="0,4" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="6" Margin="0,18,0,0" Padding="22" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                  <TextBlock Text="System readiness" FontSize="16" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="18">
                    <TextBlock><Run Text="Broker · "/><Run Text="{x:Bind ViewModel.BrokerStatusText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock x:Name="PrerequisiteSummaryText" Text="Prerequisites · checking" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}" Opacity="0.7" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Open diagnostics" Tag="diagnostics" Click="NavigateLink_Click"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="ConnectionPage" Visibility="Collapsed">
          <StackPanel MaxWidth="900" Padding="36,28,36,48" HorizontalAlignment="Stretch" Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Text="PAQET CONNECTION" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource PaqetFireAccentBrush}" CharacterSpacing="110" />
              <TextBlock Text="Connection profile" FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="Add the server details Paqet will use. Your active adapter is detected safely by the broker."
                         FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="ConnectionInfoBar" IsOpen="False" IsClosable="True" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="ConnectionPendingText" Text="No pending changes." TextWrapping="Wrap" />
            <TextBlock Text="Either Save button applies the connection profile and routing policy together, including edits on the other page. Applying changes restarts an active connection." FontSize="12" Opacity="0.72" TextWrapping="Wrap" />

            <Border Padding="20" CornerRadius="18" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="12">
                <TextBlock Text="Saved profiles" FontSize="18" FontWeight="SemiBold" />
                <ComboBox x:Name="ProfilePicker" Header="Active profile"
                          ItemsSource="{x:Bind ProfileEntries}" DisplayMemberPath="DisplayName"
                          SelectionChanged="ProfilePicker_SelectionChanged" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="New profile" Click="NewProfileButton_Click" />
                  <Button Content="Rename" Click="RenameProfileButton_Click" />
                  <Button Content="Duplicate" Click="DuplicateProfileButton_Click" />
                  <Button Content="Make default" Click="MakeDefaultProfileButton_Click" />
                  <Button Content="Delete" Click="DeleteProfileButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Export" Click="ExportProfilesButton_Click" />
                  <DropDownButton Content="Import" AutomationProperties.Name="Import profiles">
                    <DropDownButton.Flyout>
                      <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="From file…" Click="ImportProfilesFromFileMenuItem_Click" />
                        <MenuFlyoutItem Text="From clipboard" Click="ImportProfilesFromClipboardMenuItem_Click" />
                      </MenuFlyout>
                    </DropDownButton.Flyout>
                  </DropDownButton>
                </StackPanel>
                <TextBlock Text="Portable exports include transport keys and settings grouped by engine. Keep exported files private. SOCKS credentials stay on each PC. Older redacted exports are also supported."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="16">
                <TextBlock Text="Server" FontSize="18" FontWeight="SemiBold" />
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ServerEndpointBox" Header="Server endpoint" PlaceholderText="vpn.example.com:9999" />
                  <PasswordBox x:Name="TransportKeyBox" Grid.Column="1" Header="Transport key"
                               PlaceholderText="Enter the shared Paqet key" PasswordRevealMode="Peek" />
                </Grid>
                <TextBlock Text="The transport key is kept in memory for this session and is never written to desktop-settings.json."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="TestServerButton" Content="Test server" Click="TestServerButton_Click" VerticalAlignment="Top"
                          ToolTipService.ToolTip="Pings the server host from this PC. This measures network latency only, not the Paqet tunnel." />
                  <TextBlock x:Name="ServerTestResultText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="Checks that this PC can reach the server host (ICMP ping). It does not test the Paqet tunnel."
                             FontSize="12" Opacity="0.75" AutomationProperties.LiveSetting="Polite" />
                </Grid>
              </StackPanel>
            </Border>

            <Expander Header="Network interface" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Border Padding="24" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
               <StackPanel Spacing="16">
                <TextBlock Text="Choose Automatic or select the interface PaqetFire should use for this profile. Automatic uses the interface Windows routes to the server through, and falls back to Ethernet, then Wi-Fi. Save the profile to apply your choice."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                <ComboBox x:Name="NetworkInterfaceBox" Header="Connection interface" HorizontalAlignment="Stretch"
                          DisplayMemberPath="DisplayName" SelectionChanged="NetworkInterfaceBox_SelectionChanged" />
                <TextBlock Text="Only active interfaces with an IPv4 address and default gateway are listed."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SocksEndpointBox" Header="Local SOCKS5 endpoint" Text="127.0.0.1:1080" IsReadOnly="True" />
                  <TextBox x:Name="InterfaceNameBox" Grid.Column="1" Header="Detected adapter" PlaceholderText="Click Detect adapter details" IsReadOnly="True" />
                </Grid>
                <TextBox x:Name="InterfaceGuidBox" Header="Adapter GUID" PlaceholderText="Detected automatically" IsReadOnly="True" />
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="LocalIpv4Box" Header="Local IPv4 address" PlaceholderText="Detected automatically" IsReadOnly="True" />
                  <TextBox x:Name="RouterMacBox" Grid.Column="1" Header="Router MAC address" PlaceholderText="Resolved when the broker saves" IsReadOnly="True" />
                </Grid>
                <TextBlock Text="The IP and router MAC are detected from this interface and refreshed when you save. If detection fails, reconnect the interface and retry."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                <Button x:Name="DetectAdapterButton" Content="Detect adapter details" Click="DetectAdapterButton_Click" HorizontalAlignment="Left" />
               </StackPanel>
              </Border>
            </Expander>

            <Expander x:Name="AdvancedTransportExpander" Header="Advanced transport settings" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Border Padding="24" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
               <StackPanel Spacing="16">
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="KcpModeBox" Header="KCP mode" SelectedIndex="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="normal" Tag="normal"/><ComboBoxItem Content="fast" Tag="fast"/><ComboBoxItem Content="fast2" Tag="fast2"/><ComboBoxItem Content="fast3" Tag="fast3"/><ComboBoxItem Content="manual" Tag="manual"/>
                  </ComboBox>
                  <TextBox x:Name="LocalFlagsBox" Grid.Column="1" Header="Local TCP flags" PlaceholderText="PA" />
                  <TextBox x:Name="RemoteFlagsBox" Grid.Column="2" Header="Remote TCP flags" PlaceholderText="PA" />
                </Grid>
                <TextBlock Text="Leave optional fields blank to use Paqet defaults. No-delay, interval, resend, congestion, write-delay, and immediate-ACK controls apply only in manual mode. IPv6 addresses and router MACs must match this PC's network. Encryption and FEC settings must match the server."
                            FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                <StackPanel x:Name="AdvancedOptionsPanel" Spacing="12" />
                <Button Content="Restore transport defaults" Click="ResetAdvancedOptionsButton_Click" HorizontalAlignment="Left" />
               </StackPanel>
              </Border>
            </Expander>

            <StackPanel x:Name="ConnectionSaveActions" Orientation="Horizontal" Spacing="10">
              <Button Content="Save profile" Style="{StaticResource AccentButtonStyle}" Click="SaveProfileButton_Click"
                      ToolTipService.ToolTip="Save (Ctrl+S)" />
              <Button Content="Save and connect" IsEnabled="{x:Bind ViewModel.CanSaveAndConnect, Mode=OneWay}"
                      Click="SaveAndConnectButton_Click" AccessKey="C" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RoutingPage" Visibility="Collapsed">
          <StackPanel MaxWidth="900" Padding="36,28,36,48" HorizontalAlignment="Stretch" Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Text="PROXIFYRE ROUTING" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource PaqetFireAccentBrush}" CharacterSpacing="110" />
              <TextBlock Text="Choose what uses the route" FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="Choose applications and destination regions. Engine exclusions are always locked."
                         FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="RoutingInfoBar" IsOpen="False" IsClosable="True" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="RoutingPendingText" Text="No pending changes." TextWrapping="Wrap" />
            <TextBlock Text="Either Save button applies the connection profile and routing policy together, including edits on the other page. Applying changes restarts an active connection." FontSize="12" Opacity="0.72" TextWrapping="Wrap" />

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="16">
                <TextBlock Text="Routing mode" FontSize="18" FontWeight="SemiBold" />
                <RadioButtons x:Name="RoutingModeButtons" SelectionChanged="RoutingModeButtons_SelectionChanged">
                  <RadioButton Content="All supported applications (recommended)" />
                  <RadioButton Content="Only selected applications" />
                </RadioButtons>
                <TextBlock x:Name="RoutingModeHelpText"
                           Text="All application traffic enters the PaqetFire route. Paqet, Xray, Psiphon, ProxiFyre, and the broker are excluded to prevent a loop; Npcap runs below application routing."
                           Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <TextBlock Text="Regional preset" FontSize="18" FontWeight="SemiBold" />
                <ComboBox x:Name="RegionalPresetBox" Header="Destination policy" SelectedIndex="0" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="Iran — Direct (recommended)" />
                  <ComboBoxItem Content="None — Route all destinations through Paqet" />
                </ComboBox>
                <ComboBox x:Name="DomainStrategyBox" Header="Domain strategy" SelectedIndex="1" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="AsIs — Match domain rules only" />
                  <ComboBoxItem Content="IPIfNonMatch — Resolve only when needed (recommended)" />
                  <ComboBoxItem Content="IPOnDemand — Resolve before IP rules" />
                </ComboBox>
                <TextBlock Text="The Iran preset uses Xray GeoSite and GeoIP rules. Iranian domains and addresses connect directly; everything else follows your application routing mode."
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                <ComboBox x:Name="DnsResolverBox" Header="DNS resolver" SelectedIndex="0" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="Cloudflare — Encrypted DNS through Paqet (recommended)" />
                  <ComboBoxItem Content="Google — Encrypted DNS through Paqet" />
                  <ComboBoxItem Content="Quad9 — Encrypted DNS through Paqet" />
                  <ComboBoxItem Content="System resolver — Lookups bypass PaqetFire" />
                </ComboBox>
                <ToggleSwitch x:Name="FakeDnsSwitch" Header="FakeDNS (faster first connections)" IsOn="True"
                              OnContent="On · placeholder addresses, real lookups happen on the Paqet server" OffContent="Off" />
                <TextBlock x:Name="FakeDnsHintText" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Captured DNS lookups are answered by Xray over DNS-over-HTTPS through Paqet. Local, Iranian, and custom direct domains use this network's resolver. Lookups by applications outside the route, or to LAN resolvers while local network bypass is on, are not captured. FakeDNS answers instantly with addresses from 198.18.0.0/15 and skips a tunnel round trip per new domain; it needs IPv4 routing and cannot be combined with application exclusions in all-applications mode. Applications that cache DNS themselves may need a restart after disconnecting."
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ToggleSwitch x:Name="BlockAdsSwitch" Header="Block advertising domains" IsOn="True"
                                OnContent="On by default · category-ads-all blocked" OffContent="Off" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <ToggleSwitch x:Name="BlockMalwareSwitch" Header="Block malware, phishing and cryptominers" IsOn="True"
                                  OnContent="On by default · known malicious destinations blocked" OffContent="Off" />
                    <HyperlinkButton x:Name="BlockMalwareHint" Content="Needs updated routing data (Settings → Routing data)"
                                     Tag="settings" Click="NavigateLink_Click" Padding="0" FontSize="12" Visibility="Collapsed"
                                     ToolTipService.ToolTip="The data bundled with Xray has no malware categories. The rule applies once updated routing data is installed." />
                  </StackPanel>
                </Grid>
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ToggleSwitch x:Name="BlockQuicSwitch" Header="Block QUIC" IsOn="True"
                                OnContent="On · routed UDP 443 falls back to TCP" OffContent="Off (HTTP/3 allowed)" />
                  <ToggleSwitch x:Name="DirectBitTorrentSwitch" Grid.Column="1" Header="Send BitTorrent directly" IsOn="True"
                                OnContent="Direct by default — exposes your normal IP" OffContent="Off — route through Paqet" />
                </Grid>
                <TextBox x:Name="DirectRouteDestinationsBox"
                         Header="Domains and IPs routed directly (one per line)"
                         PlaceholderText="example.com&#x0a;*.another-example.com&#x0a;203.0.113.10&#x0a;2001:db8::/32"
                         AcceptsReturn="True" MinHeight="116" />
                <TextBlock Text="A domain also covers its subdomains; *.domain is accepted too. IP addresses and CIDR ranges support IPv4 and IPv6. These entries take priority over the optional blocking rules and use your normal connection, outside Paqet. For protocols where no hostname is visible, add the IP or CIDR."
                           TextWrapping="Wrap" Opacity="0.68" />
              </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <TextBlock Text="Exit proxy" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Optionally leave the internet through a second network after your Paqet server, so websites see that network's address and country instead of the server's."
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                <ComboBox x:Name="ExitProxyBox" Header="Exit" SelectedIndex="0" HorizontalAlignment="Stretch"
                          SelectionChanged="ExitProxyBox_SelectionChanged">
                  <ComboBoxItem Content="None — Leave from the Paqet server (recommended)" Tag="none" />
                  <ComboBoxItem Content="Psiphon — Leave through the Psiphon network" Tag="psiphon" />
                </ComboBox>
                <StackPanel x:Name="PsiphonOptionsPanel" Spacing="10" Visibility="Collapsed">
                  <ComboBox x:Name="PsiphonRegionBox" Header="Psiphon exit country" HorizontalAlignment="Stretch" />
                  <TextBlock x:Name="PsiphonStatusText" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold"
                             TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="Psiphon reaches its servers only through Paqet, and destinations see a Psiphon server in the chosen country. It carries TCP only: UDP, such as calls and games, still leaves from the Paqet server. Connecting takes longer, most of all the first time while Psiphon downloads its server list through Paqet; a country Psiphon cannot serve right now fails to connect. PaqetFire uses Psiphon's public network configuration, which Psiphon Inc. may change or limit."
                             FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SelectedAppsCard" Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
              <StackPanel Spacing="12">
                <TextBlock Text="Selected applications" FontSize="18" FontWeight="SemiBold" />
                <TextBox x:Name="SelectedApplicationsBox" Header="Executable names or full paths"
                         PlaceholderText="chrome.exe&#x0a;C:\Apps\Game\game.exe"
                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="112" />
                <Expander Header="Choose installed or running applications"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Expanding="ApplicationPicker_Expanding">
                  <StackPanel Spacing="10" Padding="0,10,0,0">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="ApplicationSearchBox" PlaceholderText="Search applications or paths"
                               TextChanged="ApplicationSearchBox_TextChanged" />
                      <Button Grid.Column="1" Content="Refresh" Click="RefreshApplicationsButton_Click" />
                      <Button Grid.Column="2" Content="Browse…" Click="BrowseApplicationButton_Click" />
                    </Grid>
                    <ProgressRing x:Name="ApplicationDiscoveryProgress" IsActive="False" Width="22" Height="22" HorizontalAlignment="Left" />
                    <ListView ItemsSource="{x:Bind ApplicationEntries}" SelectionMode="None" MaxHeight="310">
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <Grid Padding="3,7" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Checked="ApplicationPickerCheckBox_Changed" Unchecked="ApplicationPickerCheckBox_Changed" />
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Opacity="0.68" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                  </StackPanel>
                </Expander>
                <TextBlock Text="Choose from discovered apps or keep manually entered executable names. Full paths avoid ambiguity." FontSize="12" Opacity="0.62" />
              </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <TextBlock Text="Safety exclusions" FontSize="18" FontWeight="SemiBold" />
                <Border Padding="14" CornerRadius="12" Background="#12FF6B42">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Always bypassed · locked" FontWeight="SemiBold" Foreground="{StaticResource PaqetFireAccentBrush}" />
                    <TextBlock Text="Paqet engine path  ·  Xray engine path  ·  ProxiFyre engine path  ·  PaqetFire broker path"
                               TextWrapping="Wrap" Opacity="0.76" />
                  </StackPanel>
                </Border>
                <TextBox x:Name="UserExclusionsBox" Header="Additional exclusions (one executable per line)"
                         PlaceholderText="steam.exe&#x0a;updater.exe" AcceptsReturn="True" MinHeight="92" />
                <ToggleSwitch x:Name="BypassLanSwitch" Header="Local network devices"
                              OnContent="Direct access — bypass PaqetFire"
                              OffContent="Route through PaqetFire" IsOn="True"
                              Toggled="BypassLanSwitch_Toggled" />
                <TextBlock Text="Keep direct access on for printers, your router, NAS, and other devices on your home or office network."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="KillSwitchToggle" Header="Routing kill switch"
                              OnContent="Routed applications fail closed"
                              OffContent="Off — applications may reconnect directly" />
                <TextBlock Text="Keeps ProxiFyre active if Paqet or Xray stops, so applications covered by the routing policy cannot fall back to a direct connection. This is not a machine-wide firewall."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <TextBlock Text="Share with your network" FontSize="18" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="ShareWithLanSwitch" Header="LAN SOCKS5 proxy"
                              OnContent="Enabled in this profile — save to apply"
                              OffContent="Off — local access only" Toggled="ShareWithLanSwitch_Toggled" />
                <TextBlock Text="Creates a separate password-protected SOCKS5 listener on this computer's active LAN IPv4 address. The installer limits incoming connections to the local subnet."
                           FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                <StackPanel x:Name="LanShareOptions" Spacing="12" Visibility="Collapsed">
                  <NumberBox x:Name="LanSharePortBox" Header="LAN SOCKS5 port" Value="1082"
                             Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact"
                             ValueChanged="LanSharePortBox_ValueChanged" HorizontalAlignment="Left" Width="200" />
                  <TextBlock x:Name="LanShareEndpointText" Text="SOCKS5 endpoint appears after the active adapter is detected."
                             FontWeight="SemiBold" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Test listener" Tag="lan" Click="TestShareListenerButton_Click" />
                    <Button Content="Copy redacted setup" Tag="lan" Click="CopyShareSetupButton_Click" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SharedCredentialsCard" Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
              <StackPanel Spacing="14">
                <TextBlock Text="Proxy sharing credentials" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="These credentials apply across all connection profiles and stay the same when you import or switch profiles. Set a password, then use Save and connect below. On your phone, use the same username and password."
                           FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ShareUsernameBox" Header="Username" Text="paqetfire" MaxLength="64" TextChanged="ShareUsernameBox_TextChanged" />
                  <PasswordBox x:Name="SharePasswordBox" Grid.Column="1" Header="Password" MaxLength="128"
                               PasswordRevealMode="Peek" PlaceholderText="At least 8 characters"
                               PasswordChanged="SharePasswordBox_PasswordChanged" />
                </Grid>
                <Button Content="Generate strong password" Click="RotateSharingPasswordButton_Click" HorizontalAlignment="Left" />
                <Border Padding="12" CornerRadius="10" Background="#18FFB020">
                  <TextBlock Text="SOCKS5 does not encrypt traffic between local devices and this computer. Use this only on a trusted local network and keep the password private."
                             FontSize="12" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <TextBlock Text="Hotspot sharing" FontSize="18" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="ShareViaHotspotSwitch" Header="Hotspot SOCKS proxy"
                              OnContent="Available to devices on the laptop hotspot"
                              OffContent="Off" Toggled="ShareViaHotspotSwitch_Toggled" />
                <TextBlock Text="Turn on Mobile hotspot in Windows Settings first. PaqetFire detects the hotspot address (usually 192.168.137.1) and shares the same route as LAN clients. SOCKS-only — phones need a SOCKS app."
                          FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                <StackPanel x:Name="HotspotOptions" Spacing="12" Visibility="Collapsed">
                  <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotspotIpBox" Header="Hotspot address" IsReadOnly="True" PlaceholderText="Detect while hotspot is on" />
                    <NumberBox x:Name="HotspotPortBox" Grid.Column="1" Header="Port" Value="10808" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" ValueChanged="HotspotPortBox_ValueChanged" />
                    <Button x:Name="DetectHotspotButton" Grid.Column="2" Content="Detect hotspot" VerticalAlignment="Bottom" Click="DetectHotspotButton_Click" />
                  </Grid>
                  <TextBlock x:Name="HotspotEndpointText" Text="SOCKS endpoint appears after hotspot is detected." FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotspotUriBox" Header="SOCKS URI for v2rayNG / HAPP (Hiddify)" IsReadOnly="True" PlaceholderText="Appears after the hotspot is detected and a sharing password is known" />
                    <Button Grid.Column="1" Content="Copy URI" Click="CopyHotspotUriButton_Click" VerticalAlignment="Bottom" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <Image x:Name="HotspotQrImage" Width="184" Height="184" Stretch="Uniform" Visibility="Collapsed"
                           AutomationProperties.Name="QR code of the hotspot SOCKS URI. Scan it with v2rayNG or HAPP/Hiddify." />
                    <StackPanel x:Name="HotspotQrPlaceholder" Spacing="8" MaxWidth="440" VerticalAlignment="Center">
                      <TextBlock x:Name="HotspotQrPlaceholderText" Text="Detect the hotspot to show a QR code for phones."
                                 TextWrapping="Wrap" Opacity="0.75" />
                      <Button x:Name="RotateForQrButton" Content="Rotate credentials to show QR" Visibility="Collapsed"
                              Click="RotateSharingPasswordButton_Click" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Test listener" Tag="hotspot" Click="TestShareListenerButton_Click" />
                    <Button Content="Copy redacted setup" Tag="hotspot" Click="CopyShareSetupButton_Click" />
                  </StackPanel>
                  <TextBlock Text="Client setup guides" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" Opacity="0.85" />
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- v2rayNG Card Button -->
                    <Button x:Name="OpenV2rayNgGuideButton" Click="OpenV2rayNgGuideButton_Click"
                            AutomationProperties.Name="v2rayNG guide: Android step-by-step setup"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="14,12" CornerRadius="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- v2rayNG Vector Icon Badge -->
                        <Border Width="38" Height="38" CornerRadius="10" Background="#7C4DFF" VerticalAlignment="Center">
                          <Path Data="M 9,26 L 29,19 L 9,12 L 9,17 L 22,19 L 9,21 Z"
                                Fill="White" Stretch="Uniform" Width="18" Height="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="v2rayNG Guide" FontWeight="SemiBold" FontSize="14" />
                          <TextBlock Text="Android step-by-step setup" FontSize="11" Opacity="0.65" />
                        </StackPanel>

                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                      </Grid>
                    </Button>

                    <!-- HAPP / Hiddify Card Button -->
                    <Button x:Name="OpenHappGuideButton" Grid.Column="1" Click="OpenHappGuideButton_Click"
                            AutomationProperties.Name="HAPP and Hiddify guide: iOS, Android and PC setup"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="14,12" CornerRadius="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- HAPP Vector Icon Badge -->
                        <Border Width="38" Height="38" CornerRadius="10" Background="#0D9488" VerticalAlignment="Center">
                          <Path Data="M 19,8 L 29,12 L 29,20 C 29,26 19,30 19,30 C 19,30 9,26 9,20 L 9,12 Z"
                                Fill="White" Stretch="Uniform" Width="17" Height="17"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="HAPP / Hiddify Guide" FontWeight="SemiBold" FontSize="14" />
                          <TextBlock Text="iOS, Android &amp; PC setup" FontSize="11" Opacity="0.65" />
                        </StackPanel>

                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </Grid>
                  <Border Padding="12" CornerRadius="10" Background="#18FFB020">
                    <TextBlock Text="Same warning as LAN: SOCKS does not encrypt phone→laptop traffic. Keep hotspot WPA2 password strong and never forward this port." FontSize="12" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <TextBlock Text="Protocols" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Choose at least one protocol and address family for applications routed through ProxiFyre. LAN SOCKS5 clients use Xray's routing rules independently."
                           Opacity="0.65" TextWrapping="Wrap" />
                <Grid SizeChanged="FormGrid_SizeChanged" ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <CheckBox x:Name="RouteTcpCheckBox" Content="TCP" IsChecked="True" />
                  <CheckBox x:Name="RouteUdpCheckBox" Grid.Column="1" Content="UDP" IsChecked="True" />
                  <CheckBox x:Name="RouteIpv4CheckBox" Grid.Column="2" Content="IPv4" IsChecked="True" />
                  <CheckBox x:Name="RouteIpv6CheckBox" Grid.Column="3" Content="IPv6" IsChecked="True" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel x:Name="RoutingSaveActions" Orientation="Horizontal" Spacing="10">
              <Button Content="Save routing policy" Style="{StaticResource AccentButtonStyle}" Click="SaveRoutingButton_Click"
                      ToolTipService.ToolTip="Save (Ctrl+S)" />
              <Button Content="Save and connect" IsEnabled="{x:Bind ViewModel.CanSaveAndConnect, Mode=OneWay}"
                      Click="SaveRoutingAndConnectButton_Click" AccessKey="C" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed">
          <StackPanel MaxWidth="960" Padding="36,28,36,48" HorizontalAlignment="Stretch" Spacing="20">
            <Grid HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="6">
                <TextBlock Text="DIAGNOSTICS" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PaqetFireAccentBrush}" CharacterSpacing="110" />
                <TextBlock Text="Health and activity" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Use this page to check the broker, engines, local endpoint, and recent actions."
                           FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Content="Refresh status" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh status (F5)" />
                <Button Content="Copy diagnostics" Click="CopyDiagnosticsButton_Click"
                        ToolTipService.ToolTip="Copies a report for bug reports. Secrets, the server host, and public IP addresses are redacted." />
                <Button Content="Verify route" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanVerify, Mode=OneWay}"
                        Click="VerifyConnectionButton_Click"
                        ToolTipService.ToolTip="Available while the route is connected" />
              </StackPanel>
            </Grid>

            <Grid ColumnSpacing="14" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="5"><TextBlock Text="Broker service" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.BrokerStatusText, Mode=OneWay}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="5"><TextBlock Text="Paqet" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.PaqetStatusText, Mode=OneWay}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="5"><TextBlock Text="Xray" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.XrayStatusText, Mode=OneWay}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
              </Border>
              <Border Grid.Column="3" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="5"><TextBlock Text="Psiphon exit" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.ExitStatusText, Mode=OneWay}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
              </Border>
              <Border Grid.Column="4" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="5"><TextBlock Text="ProxiFyre" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.RoutingStatusText, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
              </Border>
            </Grid>

            <Border Padding="22" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <StackPanel Spacing="5">
                  <TextBlock Text="Connection verification" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="VerificationSummaryText"
                             Text="Connect, then verify the local proxy route over TCP, routed UDP/DNS, IPv4, and IPv6."
                             Opacity="0.68" TextWrapping="Wrap" />
                  <TextBlock Text="Only when you click Verify route, public-address checks contact api4.ipify.org and api6.ipify.org through Xray; returned addresses remain local. UDP/DNS sends a query for example.com through Xray's UDP relay; with encrypted DNS, Xray answers it over DNS-over-HTTPS through Paqet. The DNS leak check looks up whoami.akamai.net through the route and directly, then compares which resolver answered. This does not prove that every application is captured or detect WebRTC leaks."
                             FontSize="12" Opacity="0.58" TextWrapping="Wrap" />
                </StackPanel>
                <InfoBar x:Name="VerificationInfoBar" IsOpen="False" IsClosable="True" />
                <TextBlock Text="Each result is labelled Passed, Warning, Failed, or Skipped." FontSize="12" Opacity="0.58" />
                <ListView ItemsSource="{x:Bind VerificationEntries}" SelectionMode="None" MaxHeight="420">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="30" />
                          <ColumnDefinition Width="180" />
                          <ColumnDefinition Width="90" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontSize="16" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource PaqetFireAccentBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="4" Text="{Binding Duration}" Opacity="0.55" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </Border>

            <Border x:Name="RequiredSoftwareCard" Padding="22" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="16">
                <StackPanel Spacing="5">
                  <TextBlock Text="Required software" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="PaqetFire checks these system components for you. Downloads happen only when you choose Install and are removed afterward."
                             Opacity="0.68" TextWrapping="Wrap" />
                </StackPanel>
                <InfoBar x:Name="PrerequisitesInfoBar" IsOpen="False" IsClosable="True" />

                <Grid ColumnSpacing="16" RowSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Border Padding="16" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid RowSpacing="8">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Npcap" FontWeight="SemiBold" />
                        <TextBlock x:Name="NpcapPrerequisiteStatusText" Grid.Column="1" Text="Checking…" Opacity="0.7" />
                      </Grid>
                      <TextBlock x:Name="NpcapPrerequisiteDetailText" Grid.Row="1" Text="Packet capture driver used by Paqet." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                      <Button x:Name="NpcapPrerequisiteButton" Grid.Row="2" Tag="npcap" Content="Open official download" HorizontalAlignment="Left"
                              IsEnabled="False" Click="PrerequisiteActionButton_Click" />
                    </Grid>
                  </Border>

                  <Border Grid.Column="1" Padding="16" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid RowSpacing="8">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Windows Packet Filter" FontWeight="SemiBold" />
                        <TextBlock x:Name="WinpkFilterPrerequisiteStatusText" Grid.Column="1" Text="Checking…" Opacity="0.7" />
                      </Grid>
                      <TextBlock x:Name="WinpkFilterPrerequisiteDetailText" Grid.Row="1" Text="Network redirect driver used by ProxiFyre." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                      <Button x:Name="WinpkFilterPrerequisiteButton" Grid.Row="2" Tag="winpkfilter" Content="Download and install" HorizontalAlignment="Left"
                              IsEnabled="False" Click="PrerequisiteActionButton_Click" />
                    </Grid>
                  </Border>

                  <Border Grid.Row="1" Padding="16" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid RowSpacing="8">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Visual C++ runtime" FontWeight="SemiBold" />
                        <TextBlock x:Name="VisualCppPrerequisiteStatusText" Grid.Column="1" Text="Checking…" Opacity="0.7" />
                      </Grid>
                      <TextBlock x:Name="VisualCppPrerequisiteDetailText" Grid.Row="1" Text="Microsoft x64 runtime used by ProxiFyre." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                      <Button x:Name="VisualCppPrerequisiteButton" Grid.Row="2" Tag="vcredist-x64" Content="Download and install" HorizontalAlignment="Left"
                              IsEnabled="False" Click="PrerequisiteActionButton_Click" />
                    </Grid>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid RowSpacing="8">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text=".NET Framework" FontWeight="SemiBold" />
                        <TextBlock x:Name="DotNetPrerequisiteStatusText" Grid.Column="1" Text="Checking…" Opacity="0.7" />
                      </Grid>
                      <TextBlock x:Name="DotNetPrerequisiteDetailText" Grid.Row="1" Text=".NET Framework 4.7.2 or newer, used by ProxiFyre." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                      <Button x:Name="DotNetPrerequisiteButton" Grid.Row="2" Tag="dotnet-framework" Content="Open Microsoft download" HorizontalAlignment="Left"
                              IsEnabled="False" Click="PrerequisiteActionButton_Click" />
                    </Grid>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <Border Padding="22" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Activity log" FontSize="18" FontWeight="SemiBold" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy" Click="CopyLogsButton_Click" />
                    <Button Content="Clear" Click="ClearLogsButton_Click" />
                  </StackPanel>
                </Grid>
                <ListView x:Name="ActivityList" ItemsSource="{x:Bind ActivityEntries}" MinHeight="250" MaxHeight="380">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="4,7" ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" Opacity="0.55" FontFamily="Consolas" />
                        <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource PaqetFireAccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="Secrets and transport keys are never included in this log." FontSize="12" Opacity="0.58" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
          <StackPanel MaxWidth="820" Padding="36,28,36,48" HorizontalAlignment="Stretch" Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Text="SETTINGS" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource PaqetFireAccentBrush}" CharacterSpacing="110" />
              <TextBlock Text="App behavior" FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="Control what PaqetFire does at sign-in, launch, and in the background."
                         FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True" HorizontalAlignment="Stretch" />
            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="18">
                <TextBlock Text="Changes on this page apply immediately." FontSize="12" Opacity="0.62" />
                <ToggleSwitch x:Name="StartWithWindowsSwitch" Header="Start with Windows"
                              OnContent="Starts hidden in the notification area" OffContent="Disabled"
                              Toggled="AppSettingToggle_Toggled" />
                <ToggleSwitch x:Name="ConnectOnLaunchSwitch" Header="Connect when PaqetFire opens"
                              OnContent="Enabled" OffContent="Disabled" Toggled="AppSettingToggle_Toggled" />
                <ToggleSwitch x:Name="CloseToTraySwitch" Header="Close to notification area"
                              OnContent="Closing hides PaqetFire" OffContent="Closing exits PaqetFire" IsOn="True"
                              Toggled="AppSettingToggle_Toggled" />
                <ToggleSwitch x:Name="ShowNotificationsSwitch" Header="Notify about route changes while hidden"
                              OnContent="Route dropped, kill switch blocking, reconnecting, recovered" OffContent="Disabled" IsOn="True"
                              Toggled="AppSettingToggle_Toggled" />
                <ToggleSwitch x:Name="CheckForUpdatesSwitch" Header="Check for updates automatically"
                              OnContent="Enabled" OffContent="Disabled" IsOn="True" Toggled="AppSettingToggle_Toggled" />
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="14">
                <TextBlock Text="Network-aware connection" FontSize="18" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="NetworkAutomationSwitch"
                              Header="Automatically connect on unknown and untrusted networks"
                              OnContent="Enabled" OffContent="Disabled" Toggled="AppSettingToggle_Toggled" />
                <ToggleSwitch x:Name="ConnectOnTrustedNetworksSwitch"
                              Header="Also connect on trusted networks"
                              OnContent="Route required" OffContent="May stay direct" Toggled="AppSettingToggle_Toggled" />
                <TextBlock x:Name="CurrentNetworkText" Text="Current network has not been detected yet."
                           Opacity="0.68" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Trust current network" Click="TrustCurrentNetworkButton_Click" />
                  <Button Content="Require route here" Click="RequireRouteCurrentNetworkButton_Click" />
                  <Button Content="Pause for 15 minutes" Click="PauseNetworkAutomationButton_Click" />
                </StackPanel>
                <TextBlock Text="Network changes and resume events use a short settle delay and bounded reconnect backoff. Captive portals pause automatic connection; an active kill switch remains fail-closed until you change it deliberately."
                           FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="12">
                <TextBlock Text="Routing data" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="GeoIP and GeoSite rules are downloaded from the Iran-v2ray-rules project on GitHub, verified, and used from the next connection."
                           Opacity="0.68" TextWrapping="Wrap" />
                <TextBlock x:Name="RoutingDataSourceText" Text="Waiting for the broker…" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="RoutingDataCheckedText" Opacity="0.72" TextWrapping="Wrap" />
                <InfoBar x:Name="RoutingDataInfoBar" IsOpen="False" IsClosable="True" />
                <ProgressBar x:Name="RoutingDataProgressBar" IsIndeterminate="True" Visibility="Collapsed"
                             AutomationProperties.Name="Updating routing data" />
                <ToggleSwitch x:Name="RoutingDataAutomaticSwitch" Header="Update automatically" IsOn="True"
                              OnContent="Checks for a new release once a day" OffContent="Disabled"
                              Toggled="RoutingDataAutomaticSwitch_Toggled" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="RoutingDataUpdateButton" Content="Update now" Style="{StaticResource AccentButtonStyle}"
                          Click="RoutingDataUpdateButton_Click" />
                  <Button x:Name="RoutingDataBundledButton" Content="Use bundled data" Click="RoutingDataBundledButton_Click"
                          ToolTipService.ToolTip="Remove the downloaded rules, return to the data shipped with Xray, and stop automatic updates" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="20" HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="12">
                <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="AboutVersionText" Text="PaqetFire" FontWeight="SemiBold" />
                <TextBlock Text="A single Windows control surface for Paqet, Xray, and ProxiFyre. Core engines and their licenses are included with the installer."
                           Opacity="0.68" TextWrapping="Wrap" />
                <TextBlock Text="Routing always excludes Paqet, Xray, ProxiFyre, the broker, and packet-capture services to avoid a proxy loop."
                           Opacity="0.68" TextWrapping="Wrap" />
                <InfoBar x:Name="UpdateInfoBar" IsOpen="False" IsClosable="True" />
                <TextBlock x:Name="UpdateStatusText" Text="Check GitHub Releases for a newer verified build."
                           Opacity="0.72" TextWrapping="Wrap" />
                <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="CheckForUpdatesButton" Content="Check for updates" Click="CheckForUpdatesButton_Click" />
                  <Button x:Name="InstallUpdateButton" Content="Download and install" Visibility="Collapsed"
                          Style="{StaticResource AccentButtonStyle}" Click="InstallUpdateButton_Click" />
                  <Button x:Name="ViewReleaseButton" Content="View release notes" Visibility="Collapsed"
                          Click="ViewReleaseButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="12">
                <TextBlock Text="Factory reset" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Remove all profiles, encryption keys, SOCKS credentials, routing changes, and app preferences, then return to the installation defaults."
                           TextWrapping="Wrap" Opacity="0.72" />
                <Button x:Name="FactoryResetButton" Content="Reset app to defaults" Click="FactoryResetButton_Click" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <controls:V2rayNgGuideControl x:Name="V2rayNgGuideView" Visibility="Collapsed" />
        <controls:HappGuideControl x:Name="HappGuideView" Visibility="Collapsed" />
        <Border x:Name="UpdateToast" Visibility="Collapsed" MaxWidth="440" Margin="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="8"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                Translation="0,0,32">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <InfoBar x:Name="UpdateToastInfoBar" IsOpen="True" IsClosable="True" Severity="Informational"
                   Title="Update available" Closed="UpdateToastInfoBar_Closed">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
              <Button x:Name="UpdateToastInstallButton" Content="Update now"
                      Style="{StaticResource AccentButtonStyle}" Click="UpdateToastInstallButton_Click" />
              <Button Content="Release notes" Click="ViewReleaseButton_Click" />
              <Button Content="Later" Click="UpdateToastLaterButton_Click" />
            </StackPanel>
          </InfoBar>
        </Border>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
