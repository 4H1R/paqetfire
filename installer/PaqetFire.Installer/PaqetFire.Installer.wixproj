<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(PaqetFireVersion)</ProductVersion>
    <OutputName>PaqetFire-$(ProductVersion)-x64</OutputName>
    <OutputPath>..\..\artifacts\installer\</OutputPath>
    <!-- .NET 10 native runtime files expose non-MSI language metadata. -->
    <SuppressIces>ICE03</SuppressIces>
    <DesktopPublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64\desktop</DesktopPublishDir>
    <BrokerPublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64\broker</BrokerPublishDir>
    <!--
      Both publishes are self-contained, so the .NET runtime appears twice.
      Stage-InstallerPayload.ps1 splits the byte-identical root files into a
      shared tree that the MSI stores once and duplicates into the broker folder.
    -->
    <InstallerStageDir>$(MSBuildThisFileDirectory)obj\stage</InstallerStageDir>
    <SharedRuntimeFragment>$(InstallerStageDir)\SharedRuntime.wxs</SharedRuntimeFragment>
    <DefineConstants>DesktopPublishDir=$(InstallerStageDir)\desktop;BrokerPublishDir=$(InstallerStageDir)\broker;SharedPublishDir=$(InstallerStageDir)\shared;ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>

  <Target Name="StageInstallerPayload" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\Stage-InstallerPayload.ps1&quot; -DesktopPublishDir &quot;$(DesktopPublishDir)&quot; -BrokerPublishDir &quot;$(BrokerPublishDir)&quot; -StageRoot &quot;$(InstallerStageDir)&quot; -SharedFragmentPath &quot;$(SharedRuntimeFragment)&quot;" />

    <ItemGroup>
      <Compile Include="$(SharedRuntimeFragment)" />
    </ItemGroup>
  </Target>
</Project>
